#include <stdio.h>

int main() {
int n;
printf("Enter size: ");
scanf("%d", &n);

```
int arr[n];

printf("Enter elements:\n");
for(int i = 0; i < n; i++) {
    scanf("%d", &arr[i]);
}

int j = 0;

for(int i = 0; i < n; i++) {
    if(arr[i] >= 0) {
        int temp = arr[i];

        // shift elements right
        for(int k = i; k > j; k--) {
            arr[k] = arr[k-1];
        }

        arr[j] = temp;
        j++;
    }
}

printf("Result:\n");
for(int i = 0; i < n; i++) {
    printf("%d ", arr[i]);
}

return 0;
```

