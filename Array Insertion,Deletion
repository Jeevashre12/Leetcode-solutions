import java.util.*;
import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[50];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int op,pos,val;
        int choice=sc.nextInt();
        switch(choice){
            case 1:
                pos=sc.nextInt();
                val=sc.nextInt();
                for(int i=n;i>=pos;i--){
                    arr[i]=arr[i-1];
                }
                arr[pos-1]=val;
                n++;
                for(int i=0;i<n;i++){
                    System.out.print(arr[i]+" ");
                }
                break;
            case 2:
                pos=sc.nextInt();
                for(int i=pos-1;i<n-1;i++){
                    arr[i]=arr[i+1];
                }
                n--;
                for(int i=0;i<n;i++){
                    System.out.print(arr[i]+" ");
                }
                break;
            default:
            System.out.print("Invalid");
        }
    }
}
