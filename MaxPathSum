import java.util.*;

public class Main{

    static class Node{
        int data;
        Node left,right;

        Node(int data){
            this.data=data;
        }
    }

    static int maxSum=Integer.MIN_VALUE;

    static int maxPath(Node root){

        if(root==null)
            return 0;

        int left=maxPath(root.left);
        int right=maxPath(root.right);

        int currentSum = left + right + root.data;

        maxSum = Math.max(maxSum,currentSum);

        return root.data + Math.max(left,right);
    }

    static Node buildTree(String[] arr){

        if(arr.length==0 || arr[0].equals("-1"))
            return null;

        Queue<Node> q=new LinkedList<>();

        Node root=new Node(Integer.parseInt(arr[0]));
        q.add(root);

        int i=1;

        while(!q.isEmpty() && i<arr.length){

            Node curr=q.poll();

            if(i<arr.length && !arr[i].equals("-1")){
                curr.left=new Node(Integer.parseInt(arr[i]));
                q.add(curr.left);
            }
            i++;

            if(i<arr.length && !arr[i].equals("-1")){
                curr.right=new Node(Integer.parseInt(arr[i]));
                q.add(curr.right);
            }
            i++;
        }

        return root;
    }

    public static void main(String[] args){

        Scanner sc=new Scanner(System.in);

        int n=sc.nextInt();
        sc.nextLine();

        String[] arr=sc.nextLine().split(" ");

        Node root=buildTree(arr);

        maxPath(root);

        System.out.println(maxSum);
    }
}
